{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nethernet:external-signaling:v1",
  "title": "NetherNet External Signaling v1",
  "type": "object",
  "required": [
    "protocol",
    "publicKeyJwk"
  ],
  "properties": {
    "protocol": {
      "const": "nethernet-external-signaling-v1"
    },
    "publicKeyJwk": {
      "type": "object",
      "required": [
        "crv",
        "kty",
        "x",
        "y"
      ],
      "not": {
        "required": [
          "d"
        ]
      },
      "properties": {
        "crv": {
          "const": "P-384"
        },
        "kty": {
          "const": "EC"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{64}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{64}$"
        }
      }
    },
    "label": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    }
  },
  "$defs": {
    "discovery": {
      "type": "object",
      "required": [
        "provider",
        "protocols",
        "signatures",
        "authorization",
        "limits"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 267
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "authorization": {
          "type": "object",
          "required": [
            "schemes"
          ],
          "properties": {
            "schemes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "limits": {
          "type": "object",
          "required": [
            "heartbeatIntervalMs"
          ],
          "properties": {
            "heartbeatIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 30000
            }
          }
        }
      },
      "description": "Clients ignore unknown list entries and fail only when none they support is listed."
    },
    "challenge": {
      "type": "object",
      "required": [
        "protocol",
        "signature",
        "challengeId",
        "nonce",
        "audience",
        "thumbprint",
        "context",
        "contextDigest",
        "expiresAt",
        "serverTime",
        "pow"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        },
        "signature": {
          "const": "nxs-es384-v1"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "serverTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authorization": {
          "type": "object",
          "required": [
            "scheme",
            "reference"
          ],
          "properties": {
            "scheme": {
              "enum": [
                "anonymous-proof-of-work",
                "bearer-token"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "context": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "new-service",
                "attach-instance",
                "recover"
              ]
            },
            "label": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "authorizationId": {
              "type": "string",
              "maxLength": 256
            },
            "serviceId": {
              "type": "string",
              "maxLength": 256
            },
            "registrationId": {
              "type": "string",
              "maxLength": 256
            }
          },
          "description": "Absent strings digest as empty. recover selects recovery of registrationId."
        },
        "pow": {
          "type": "object",
          "required": [
            "difficulty"
          ],
          "properties": {
            "difficulty": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          }
        },
        "challengeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "audience": {
          "type": "string",
          "maxLength": 267
        },
        "thumbprint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "protocol",
        "challengeId",
        "proofNonce",
        "signature",
        "idempotencyKey"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        },
        "challengeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "proofNonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{128}$"
        }
      }
    },
    "registration": {
      "type": "object",
      "required": [
        "protocol",
        "provider",
        "registrationId",
        "instanceId",
        "keyId",
        "leaseGeneration"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        },
        "provider": {
          "type": "string",
          "maxLength": 267
        },
        "registrationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "leaseGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "serviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "publicAddress": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\s]+(?:[/?#]\\S*)?$"
        },
        "admissionKey": {
          "$ref": "#/$defs/admissionKey"
        },
        "operatorAction": {
          "$ref": "#/$defs/operatorAction"
        }
      },
      "dependentRequired": {
        "serviceId": [
          "publicAddress"
        ],
        "publicAddress": [
          "serviceId"
        ]
      },
      "description": "An independent runtime identity. Optional serviceId/publicAddress describe a public endpoint at this observation; they are not stable instance identity. Attached instances may have no public endpoint or serve several endpoints."
    },
    "rotation": {
      "type": "object",
      "required": [
        "publicKeyJwk",
        "proof"
      ],
      "properties": {
        "publicKeyJwk": {
          "$ref": "#/properties/publicKeyJwk"
        },
        "proof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{128}$"
        }
      },
      "description": "proof is the replacement key's signature over the rotation proof array."
    },
    "rotationResponse": {
      "type": "object",
      "required": [
        "keyId"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "oldKeyRetiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "When the provider stops accepting the previous key unless it is retired sooner."
        }
      }
    },
    "admissionKey": {
      "type": "object",
      "required": [
        "keyId",
        "secret"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "secret": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "description": "43 base64url characters encoding 32 random bytes. Derivations use the characters' ASCII bytes, not the decoding."
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){1,7}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "critical",
          "data"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "critical": {
            "type": "boolean"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "x-max-utf8-bytes": 16384,
      "properties": {
        "dev.opencollab.nxs.connectivity": {
          "$ref": "#/$defs/connectivityObservation"
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": [
        "registrationId",
        "protocol"
      ],
      "properties": {
        "registrationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        }
      }
    },
    "register": {
      "oneOf": [
        {
          "$ref": "#"
        },
        {
          "$ref": "#/$defs/recovery"
        }
      ]
    },
    "hostProfile": {
      "type": "object",
      "required": [
        "candidates",
        "dtlsFingerprint",
        "admissionKeyId",
        "sctpPort",
        "maxMessageSize",
        "statelessAdmission"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "foundation",
              "priority",
              "address",
              "port",
              "type"
            ],
            "properties": {
              "foundation": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,32}$"
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "address": {
                "type": "string",
                "maxLength": 45,
                "pattern": "^[0-9A-Fa-f:.]+$",
                "anyOf": [
                  {
                    "format": "ipv4"
                  },
                  {
                    "format": "ipv6"
                  }
                ]
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "type": {
                "enum": [
                  "host",
                  "srflx",
                  "relay"
                ]
              },
              "expiresAt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Optional deadline for a server-reflexive candidate, in Unix milliseconds. When absent, the host refreshes its current candidates under the heartbeat lease."
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "expiresAt"
                  ]
                },
                "then": {
                  "properties": {
                    "type": {
                      "const": "srflx"
                    }
                  }
                }
              }
            ]
          }
        },
        "dtlsFingerprint": {
          "type": "string",
          "pattern": "^sha-256 [0-9A-F]{2}(?::[0-9A-F]{2}){31}$"
        },
        "admissionKeyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "sctpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxMessageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "statelessAdmission": {
          "type": "object",
          "required": [
            "capability",
            "incarnation"
          ],
          "properties": {
            "capability": {
              "const": "nethernet.stateless-admission.v1"
            },
            "incarnation": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "assistedFamilies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  4,
                  6
                ]
              },
              "description": "Address families on which the host accepts assisted joins over the WebSocket transport."
            }
          }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "required": [
        "acceptingPlayers",
        "capacity",
        "connectedPlayers"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "connectedPlayers": {
          "$ref": "#/$defs/connectedPlayers"
        },
        "gameOutcomes": {
          "enum": [
            "available",
            "unavailable"
          ],
          "description": "Report with the initial host profile and whenever this capability changes. Omission preserves the current generation value; initially unavailable."
        },
        "software": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "location": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/location"
            }
          ]
        },
        "bedrockProtocols": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bedrockProtocols"
            }
          ],
          "description": "The Bedrock protocols the host accepts at login. Send it with the initial host profile and whenever it changes; null clears an earlier report and omission preserves the value."
        },
        "serverStatus": {
          "$ref": "#/$defs/serverStatus",
          "description": "The public listing. Send it with every heartbeat while it applies; providers list the sum of connectedPlayers.count."
        },
        "hostProfile": {
          "$ref": "#/$defs/hostProfile"
        },
        "hostProfileRevision": {
          "type": "string",
          "maxLength": 184
        },
        "installedAdmissionKeyIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4}$"
          }
        },
        "admissionKeyRequestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "acceptingPlayers": {
          "type": "boolean",
          "description": "Application ability and willingness to accept new players, independent of sampled counts."
        }
      }
    },
    "checkIn": {
      "type": "object",
      "required": [
        "afterMillis",
        "leaseMillis",
        "minUpdateIntervalMillis"
      ],
      "properties": {
        "afterMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "leaseMillis": {
          "type": "integer",
          "minimum": 1001,
          "maximum": 86700000
        },
        "minUpdateIntervalMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        }
      },
      "description": "Durations from when the host sent the heartbeat. afterMillis < leaseMillis <= afterMillis + 300000; minUpdateIntervalMillis <= afterMillis."
    },
    "heartbeatResponse": {
      "type": "object",
      "required": [
        "hostProfileRevision",
        "readiness",
        "admissionKeyRetirements"
      ],
      "properties": {
        "hostProfileRevision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 184,
          "description": "The profile the provider holds; null when it holds none, so the host sends hostProfile again."
        },
        "readiness": {
          "type": "object",
          "required": [
            "routable",
            "reasons"
          ],
          "properties": {
            "routable": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "description": "Provider-defined codes for why the host is not routable; informational only."
            }
          }
        },
        "checkIn": {
          "$ref": "#/$defs/checkIn"
        },
        "admissionKeyRequest": {
          "type": "object",
          "required": [
            "id",
            "keyId"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "keyId": {
              "type": "string",
              "pattern": "^[A-Z0-9]{4}$"
            }
          }
        },
        "admissionKey": {
          "$ref": "#/$defs/admissionKey"
        },
        "admissionKeyRetirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "keyId",
              "retireAfter"
            ],
            "properties": {
              "keyId": {
                "type": "string",
                "pattern": "^[A-Z0-9]{4}$"
              },
              "retireAfter": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "operatorActionAvailable": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "outcomes": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "ticketId",
              "stage",
              "occurredAt"
            ],
            "properties": {
              "ticketId": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "stage": {
                "enum": [
                  "ticket.ice_seen",
                  "ticket.data_channels_open",
                  "ticket.game_joined",
                  "ticket.game_rejected",
                  "ticket.failed"
                ]
              },
              "occurredAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "remoteAddress": {
                "type": "string",
                "maxLength": 45,
                "pattern": "^[0-9A-Fa-f:.]+$",
                "anyOf": [
                  {
                    "format": "ipv4"
                  },
                  {
                    "format": "ipv6"
                  }
                ],
                "description": "Host-observed selected peer IP at transport establishment; never a signaling address or unselected SDP candidate."
              },
              "remotePort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "dependentRequired": {
              "remoteAddress": [
                "remotePort"
              ],
              "remotePort": [
                "remoteAddress"
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "ticket.failed"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "connectedPlayers": {
      "type": "object",
      "required": [
        "count",
        "sampledAt"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "sampledAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Actual players connected to this runtime, including players kept while it accepts no new ones. sampledAt is Unix milliseconds and covers this count and the heartbeat capacity from the same host observation. Never derive it from listing values, load, tickets or reservations."
    },
    "connectivityObservation": {
      "type": "object",
      "required": [
        "version",
        "critical",
        "data"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "critical": {
          "const": false
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "diagnostics",
                "candidateRevision",
                "method"
              ],
              "properties": {
                "diagnostics": {
                  "type": "boolean"
                },
                "candidateRevision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "method": {
                  "enum": [
                    "defined",
                    "discovered",
                    "warm_stun"
                  ]
                },
                "probeCandidates": {
                  "$ref": "#/$defs/hostProfile/properties/candidates"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "method",
                "candidateRevision",
                "checks"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "defined",
                    "discovered",
                    "warm_stun"
                  ]
                },
                "candidateRevision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "checks": {
                  "type": "array",
                  "maxItems": 18,
                  "items": {
                    "type": "object",
                    "required": [
                      "region",
                      "family",
                      "outcome",
                      "checkedAt",
                      "expiresAt"
                    ],
                    "properties": {
                      "region": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "family": {
                        "enum": [
                          4,
                          6
                        ]
                      },
                      "outcome": {
                        "enum": [
                          "established",
                          "not-established",
                          "unknown",
                          "unavailable"
                        ]
                      },
                      "checkedAt": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "expiresAt": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "method": {
                        "enum": [
                          "defined",
                          "discovered",
                          "warm_stun",
                          "per_join"
                        ]
                      },
                      "target": {
                        "type": "object",
                        "required": [
                          "address",
                          "port"
                        ],
                        "properties": {
                          "address": {
                            "type": "string",
                            "maxLength": 45,
                            "pattern": "^[0-9A-Fa-f:.]+$",
                            "anyOf": [
                              {
                                "format": "ipv4"
                              },
                              {
                                "format": "ipv6"
                              }
                            ]
                          },
                          "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          }
                        }
                      }
                    }
                  }
                }
              },
              "not": {
                "required": [
                  "diagnostics"
                ]
              }
            },
            {
              "type": "object",
              "required": [
                "stunServers"
              ],
              "properties": {
                "stunServers": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "host",
                      "port"
                    ],
                    "properties": {
                      "host": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[A-Za-z0-9.:-]+$"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    }
                  }
                }
              },
              "not": {
                "required": [
                  "method"
                ]
              }
            }
          ]
        }
      }
    },
    "serverStatus": {
      "type": "object",
      "required": [
        "name",
        "level",
        "maxPlayerCount",
        "gameType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "level": {
          "type": "string",
          "maxLength": 128,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "maxPlayerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "gameType": {
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "dependentRequired": {
        "latitude": [
          "longitude"
        ],
        "longitude": [
          "latitude"
        ]
      },
      "anyOf": [
        {
          "required": [
            "country"
          ]
        },
        {
          "required": [
            "latitude"
          ]
        }
      ],
      "description": "Where the operator says the host runs; null clears an earlier declaration."
    },
    "bedrockProtocols": {
      "type": "object",
      "required": [
        "accepted",
        "version"
      ],
      "properties": {
        "accepted": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "description": "Exactly the accepted protocols, not a range, in strictly ascending order, which JSON Schema expresses only as uniqueness."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          },
          "description": "The game version of the highest accepted protocol."
        }
      }
    },
    "operatorAction": {
      "type": "object",
      "required": [
        "url",
        "text",
        "expiresAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:https://[^/?#@\\s]+|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?)(?:[/?#]\\S*)?$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "A link for the host's operator. It may carry a one-time credential: show it, but never open or forward it or keep it in saved state."
    },
    "operatorActionResponse": {
      "type": "object",
      "properties": {
        "operatorAction": {
          "$ref": "#/$defs/operatorAction"
        }
      }
    },
    "retire": {
      "type": "object",
      "required": [
        "keyId"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      }
    },
    "websocketOperation": {
      "type": "object",
      "required": [
        "kind",
        "operation",
        "headers",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "operation"
        },
        "operation": {
          "enum": [
            "heartbeat",
            "outcomes",
            "rotate",
            "retire",
            "deregister"
          ]
        },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "body": {
          "type": "string"
        }
      },
      "description": "Host to provider. headers carries the signed NXS request headers; body is the original JSON text."
    },
    "websocketResponse": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "status",
        "headers",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "response"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "body": {
          "type": "string",
          "x-max-utf8-bytes": 65536
        }
      },
      "description": "Provider to host. id is the operation's idempotency key."
    },
    "assistedJoin": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "id",
        "expiresAt",
        "instanceId",
        "generation",
        "incarnation",
        "keyId",
        "hostFingerprint",
        "networkId",
        "localUfrag",
        "localPassword",
        "offer"
      ],
      "properties": {
        "kind": {
          "const": "assisted-join"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "incarnation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "hostFingerprint": {
          "$ref": "#/$defs/hostProfile/properties/dtlsFingerprint"
        },
        "networkId": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$"
        },
        "cpk": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{160}$"
        },
        "localUfrag": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^NXS1"
        },
        "localPassword": {
          "type": "string",
          "minLength": 22,
          "maxLength": 256
        },
        "offer": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "description": "Provider to host. cpk is present for players and absent for diagnostics (networkId 0)."
    },
    "assistedJoinResult": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "accepted"
      ],
      "properties": {
        "kind": {
          "const": "assisted-join-result"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "accepted": {
          "type": "boolean"
        },
        "answer": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "answer"
            ]
          }
        }
      ],
      "description": "Host to provider."
    }
  },
  "x-context-order": [
    "mode",
    "label",
    "authorizationId",
    "serviceId",
    "registrationId"
  ],
  "x-signature-format": "ES384 P1363 r||s 96 bytes unpadded base64url",
  "x-canonicalization": "UTF-8 JSON arrays, no whitespace, no Unicode normalization, epoch milliseconds as integers, absent context strings are empty",
  "x-discovery-path": "/.well-known/nethernet-external-signaling",
  "x-headers": [
    "nxs-instance-id",
    "nxs-key-id",
    "nxs-timestamp",
    "nxs-signature-version",
    "nxs-generation",
    "nxs-sequence",
    "nxs-signature",
    "idempotency-key"
  ],
  "x-operations": [
    "register",
    "complete",
    "heartbeat",
    "outcomes",
    "rotate",
    "retire",
    "deregister",
    "operator-action"
  ]
}
