{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nethernet:external-signaling:v1",
  "title": "NetherNet External Signaling v1",
  "type": "object",
  "required": [
    "protocol",
    "publicKeyJwk"
  ],
  "properties": {
    "protocol": {
      "const": "nethernet-external-signaling-v1"
    },
    "publicKeyJwk": {
      "type": "object",
      "required": [
        "crv",
        "kty",
        "x",
        "y"
      ],
      "not": {
        "required": [
          "d"
        ]
      },
      "properties": {
        "crv": {
          "const": "P-384"
        },
        "kty": {
          "const": "EC"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{64}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{64}$"
        }
      }
    },
    "label": {
      "type": "string",
      "maxLength": 128
    }
  },
  "$defs": {
    "discovery": {
      "type": "object",
      "required": [
        "provider",
        "protocols",
        "signatures",
        "authorization",
        "limits"
      ],
      "properties": {
        "authorization": {
          "type": "object",
          "required": [
            "schemes"
          ],
          "properties": {
            "schemes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "anonymous-proof-of-work",
                  "bearer-token"
                ]
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "limits": {
          "type": "object",
          "required": [
            "heartbeatIntervalMs"
          ],
          "properties": {
            "heartbeatIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 30000
            }
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "required": [
        "protocol",
        "signature",
        "challengeId",
        "nonce",
        "audience",
        "thumbprint",
        "context",
        "contextDigest",
        "expiresAt",
        "serverTime",
        "pow"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        },
        "signature": {
          "const": "nxs-es384-v1"
        },
        "expiresAt": {
          "type": "integer"
        },
        "serverTime": {
          "type": "integer"
        },
        "authorization": {
          "type": "object",
          "required": [
            "scheme",
            "reference"
          ],
          "properties": {
            "scheme": {
              "enum": [
                "anonymous-proof-of-work",
                "bearer-token"
              ]
            },
            "reference": {
              "type": "string"
            }
          }
        },
        "context": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "new-service",
                "attach-instance",
                "recover"
              ]
            },
            "label": {
              "type": "string"
            },
            "authorizationId": {
              "type": "string"
            },
            "serviceId": {
              "type": "string"
            },
            "registrationId": {
              "type": "string"
            }
          },
          "description": "Absent strings digest as empty. recover selects recovery of registrationId."
        },
        "pow": {
          "type": "object",
          "required": [
            "difficulty"
          ],
          "properties": {
            "difficulty": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "protocol",
        "challengeId",
        "proofNonce",
        "signature",
        "idempotencyKey"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        }
      }
    },
    "registration": {
      "type": "object",
      "required": [
        "protocol",
        "provider",
        "registrationId",
        "instanceId",
        "keyId",
        "leaseGeneration"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "serviceId": {
          "type": "string",
          "minLength": 1
        },
        "publicAddress": {
          "type": "string",
          "minLength": 1
        },
        "admissionKey": {
          "$ref": "#/$defs/admissionKey"
        },
        "operatorAction": {
          "$ref": "#/$defs/operatorAction"
        }
      },
      "dependentRequired": {
        "serviceId": [
          "publicAddress"
        ],
        "publicAddress": [
          "serviceId"
        ]
      },
      "description": "An independent runtime identity. Optional serviceId/publicAddress describe a public endpoint at this observation; they are not stable instance identity. Attached instances may have no public endpoint or serve several endpoints."
    },
    "rotation": {
      "type": "object",
      "required": [
        "publicKeyJwk",
        "proof"
      ]
    },
    "rotationResponse": {
      "type": "object",
      "required": [
        "keyId"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "oldKeyRetiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "When the provider stops accepting the previous key unless it is retired sooner."
        }
      }
    },
    "admissionKey": {
      "type": "object",
      "required": [
        "keyId",
        "secret"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "secret": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){1,7}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "critical",
          "data"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "critical": {
            "type": "boolean"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "x-max-utf8-bytes": 16384,
      "properties": {
        "dev.opencollab.nxs.connectivity": {
          "$ref": "#/$defs/connectivityObservation"
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": [
        "registrationId",
        "protocol"
      ],
      "properties": {
        "registrationId": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "const": "nethernet-external-signaling-v1"
        }
      }
    },
    "register": {
      "oneOf": [
        {
          "$ref": "#"
        },
        {
          "$ref": "#/$defs/recovery"
        }
      ]
    },
    "hostProfile": {
      "type": "object",
      "required": [
        "candidates",
        "dtlsFingerprint",
        "admissionKeyId",
        "sctpPort",
        "maxMessageSize",
        "statelessAdmission"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "foundation",
              "priority",
              "address",
              "port",
              "type"
            ],
            "properties": {
              "foundation": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,32}$"
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "address": {
                "type": "string",
                "maxLength": 253
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "type": {
                "enum": [
                  "host",
                  "srflx",
                  "relay"
                ]
              },
              "expiresAt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Optional deadline for a server-reflexive candidate, in Unix milliseconds. When absent, the host refreshes its current candidates under the heartbeat lease."
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "expiresAt"
                  ]
                },
                "then": {
                  "properties": {
                    "type": {
                      "const": "srflx"
                    }
                  }
                }
              }
            ]
          }
        },
        "dtlsFingerprint": {
          "type": "string",
          "pattern": "^sha-256 [0-9A-F]{2}(?::[0-9A-F]{2}){31}$"
        },
        "admissionKeyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "sctpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxMessageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "statelessAdmission": {
          "type": "object",
          "required": [
            "capability",
            "incarnation"
          ],
          "properties": {
            "capability": {
              "const": "nethernet.stateless-admission.v1"
            },
            "incarnation": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "assistedFamilies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  4,
                  6
                ]
              },
              "description": "Address families on which the host accepts assisted joins over the WebSocket transport."
            }
          }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "required": [
        "acceptingPlayers",
        "capacity",
        "clockUnixMillis"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "clockUnixMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gameOutcomes": {
          "enum": [
            "available",
            "unavailable"
          ],
          "description": "Report with the initial host profile and whenever this capability changes. Omission preserves the current generation value; initially unavailable."
        },
        "software": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "location": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/location"
            }
          ]
        },
        "serverStatus": {
          "$ref": "#/$defs/serverStatus",
          "description": "Renew listing metadata together. Omit players when the heartbeat supplies playerCount."
        },
        "hostProfile": {
          "$ref": "#/$defs/hostProfile"
        },
        "hostProfileRevision": {
          "type": "string",
          "maxLength": 184
        },
        "installedAdmissionKeyIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4}$"
          }
        },
        "admissionKeyRequestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "playerCount": {
          "$ref": "#/$defs/playerCount"
        },
        "acceptingPlayers": {
          "type": "boolean",
          "description": "Application ability and willingness to accept new players, independent of sampled counts."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "serverStatus"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "playerCount"
                ]
              },
              {
                "properties": {
                  "serverStatus": {
                    "required": [
                      "players"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "checkIn": {
      "type": "object",
      "required": [
        "afterMillis",
        "leaseMillis",
        "minUpdateIntervalMillis"
      ],
      "properties": {
        "afterMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "leaseMillis": {
          "type": "integer",
          "minimum": 1001,
          "maximum": 86700000
        },
        "minUpdateIntervalMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        }
      },
      "description": "Durations from when the host sent the heartbeat. afterMillis < leaseMillis <= afterMillis + 300000; minUpdateIntervalMillis <= afterMillis."
    },
    "heartbeatResponse": {
      "type": "object",
      "required": [
        "hostProfileRevision",
        "readiness",
        "admissionKeyRetirements"
      ],
      "properties": {
        "hostProfileRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "type": "object",
          "required": [
            "routable",
            "reasons"
          ]
        },
        "checkIn": {
          "$ref": "#/$defs/checkIn"
        },
        "admissionKeyRequest": {
          "type": "object",
          "required": [
            "id",
            "keyId"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "keyId": {
              "type": "string",
              "pattern": "^[A-Z0-9]{4}$"
            }
          }
        },
        "admissionKey": {
          "$ref": "#/$defs/admissionKey"
        },
        "admissionKeyRetirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "keyId",
              "retireAfter"
            ],
            "properties": {
              "keyId": {
                "type": "string",
                "pattern": "^[A-Z0-9]{4}$"
              },
              "retireAfter": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "operatorActionAvailable": {
          "type": "boolean"
        }
      }
    },
    "outcomes": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "ticketId",
              "stage",
              "occurredAt"
            ],
            "properties": {
              "ticketId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "stage": {
                "enum": [
                  "ticket.ice_seen",
                  "ticket.data_channels_open",
                  "ticket.game_joined",
                  "ticket.game_rejected",
                  "ticket.failed"
                ]
              },
              "occurredAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reason": {
                "type": "string",
                "maxLength": 128
              },
              "remoteAddress": {
                "type": "string",
                "maxLength": 45,
                "pattern": "^[0-9A-Fa-f:.]+$",
                "anyOf": [
                  {
                    "format": "ipv4"
                  },
                  {
                    "format": "ipv6"
                  }
                ],
                "description": "Host-observed selected peer IP at transport establishment; never a signaling address or unselected SDP candidate."
              },
              "remotePort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "dependentRequired": {
              "remoteAddress": [
                "remotePort"
              ],
              "remotePort": [
                "remoteAddress"
              ]
            }
          }
        }
      }
    },
    "playerCount": {
      "type": "object",
      "required": [
        "connectedPlayers",
        "sampledAt"
      ],
      "properties": {
        "connectedPlayers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "sampledAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Actual players connected to this runtime, including still-connected draining players. sampledAt is Unix milliseconds and covers this count and the heartbeat capacity from the same host observation. Absence means unknown. Never derive this value from public serverStatus, load, tickets or reservations."
    },
    "connectivityObservation": {
      "type": "object",
      "required": [
        "version",
        "critical",
        "data"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "critical": {
          "const": false
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "diagnostics",
                "candidateRevision",
                "method"
              ],
              "properties": {
                "diagnostics": {
                  "type": "boolean"
                },
                "candidateRevision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "method": {
                  "enum": [
                    "defined",
                    "discovered",
                    "warm_stun"
                  ]
                },
                "probeCandidates": {
                  "$ref": "#/$defs/hostProfile/properties/candidates"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "method",
                "candidateRevision",
                "checks"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "defined",
                    "discovered",
                    "warm_stun"
                  ]
                },
                "candidateRevision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "checks": {
                  "type": "array",
                  "maxItems": 18,
                  "items": {
                    "type": "object",
                    "required": [
                      "region",
                      "family",
                      "outcome",
                      "checkedAt",
                      "expiresAt"
                    ],
                    "properties": {
                      "region": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "family": {
                        "enum": [
                          4,
                          6
                        ]
                      },
                      "outcome": {
                        "enum": [
                          "established",
                          "not-established",
                          "unknown",
                          "unavailable"
                        ]
                      },
                      "checkedAt": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "expiresAt": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "method": {
                        "enum": [
                          "defined",
                          "discovered",
                          "warm_stun",
                          "per_join"
                        ]
                      },
                      "target": {
                        "type": "object",
                        "required": [
                          "address",
                          "port"
                        ],
                        "properties": {
                          "address": {
                            "type": "string",
                            "maxLength": 45,
                            "pattern": "^[0-9A-Fa-f:.]+$",
                            "anyOf": [
                              {
                                "format": "ipv4"
                              },
                              {
                                "format": "ipv6"
                              }
                            ]
                          },
                          "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          }
                        }
                      }
                    }
                  }
                }
              },
              "not": {
                "required": [
                  "diagnostics"
                ]
              }
            },
            {
              "type": "object",
              "required": [
                "stunServers"
              ],
              "properties": {
                "stunServers": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "host",
                      "port"
                    ],
                    "properties": {
                      "host": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[A-Za-z0-9.:-]+$"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    }
                  }
                }
              },
              "not": {
                "required": [
                  "method"
                ]
              }
            }
          ]
        }
      }
    },
    "serverStatus": {
      "type": "object",
      "required": [
        "name",
        "level",
        "maxPlayers",
        "gameType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
          }
        },
        "level": {
          "type": "string",
          "maxLength": 128,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]"
          }
        },
        "players": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "gameType": {
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "dependentRequired": {
        "latitude": [
          "longitude"
        ],
        "longitude": [
          "latitude"
        ]
      },
      "anyOf": [
        {
          "required": [
            "country"
          ]
        },
        {
          "required": [
            "latitude"
          ]
        }
      ],
      "description": "Where the operator says the host runs; null clears an earlier declaration."
    },
    "operatorAction": {
      "type": "object",
      "required": [
        "url",
        "text",
        "expiresAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:https://|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?:[:/]|$))"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "expiresAt": {
