{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nethernet.org/external-signaling/control-v1.authority.schema.json",
  "title": "Draft separate cache authority renewal proofs",
  "$comment": "Staged optional profile. Exact UTF-8 byte limits, canonical integer spelling and origins, duplicate field rejection, sorted capabilities/permissions, key families, raw ES384 signature bytes, cross-field deadlines, original request association, immutable source floors and installation nonce/current-key guards are mandatory in addition to JSON Schema. This positive proof does not establish session readiness.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "opaque": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "addressed",
          "assisted-diagnostic",
          "assisted-gameplay",
          "request-response"
        ]
      },
      "contains": {
        "const": "request-response"
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "keyId",
        "signature"
      ],
      "properties": {
        "scheme": {
          "const": "nxs-control-es384-v1"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{128}$"
        }
      }
    },
    "activeWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "sessionEpoch",
        "sessionId",
        "connectionId",
        "keyId",
        "machineKeyRevision"
      ],
      "properties": {
        "transport": {
          "enum": [
            "websocket",
            "https"
          ]
        },
        "sessionEpoch": {
          "$ref": "#/$defs/positive"
        },
        "sessionId": {
          "$ref": "#/$defs/opaque"
        },
        "connectionId": {
          "$ref": "#/$defs/opaque"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "machineKeyRevision": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requestId",
        "audience",
        "instanceId",
        "generation",
        "writer",
        "capabilities",
        "sentAt",
        "expiresAt",
        "authentication",
        "kind",
        "method",
        "encodedPathAndQuery",
        "authorityNotAfter"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/opaque"
        },
        "audience": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2048
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/positive"
        },
        "writer": {
          "$ref": "#/$defs/activeWriter"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "sentAt": {
          "$ref": "#/$defs/uint"
        },
        "expiresAt": {
          "$ref": "#/$defs/uint"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "kind": {
          "const": "authority-request"
        },
        "method": {
          "const": "POST"
        },
        "encodedPathAndQuery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "authorityNotAfter": {
          "$ref": "#/$defs/uint"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requestId",
        "audience",
        "instanceId",
        "generation",
        "writer",
        "capabilities",
        "sentAt",
        "expiresAt",
        "authentication",
        "kind",
        "requestDigest",
        "sourceId",
        "sourceRevision",
        "sourceWatermark",
        "sourceCheckedAt",
        "sourceExpiresAt",
        "subjectExpiresAt",
        "authorityExpiresAt",
        "permissions"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/opaque"
        },
        "audience": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2048
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/positive"
        },
        "writer": {
          "$ref": "#/$defs/activeWriter"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "sentAt": {
          "$ref": "#/$defs/uint"
        },
        "expiresAt": {
          "$ref": "#/$defs/uint"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "kind": {
          "const": "authority-response"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceRevision": {
          "$ref": "#/$defs/uint"
        },
        "sourceWatermark": {
          "$ref": "#/$defs/uint"
        },
        "sourceCheckedAt": {
          "$ref": "#/$defs/uint"
        },
        "sourceExpiresAt": {
          "$ref": "#/$defs/uint"
        },
        "subjectExpiresAt": {
          "$ref": "#/$defs/uint"
        },
        "authorityExpiresAt": {
          "$ref": "#/$defs/uint"
        },
        "permissions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "control.assisted",
              "control.status"
            ]
          }
        }
      }
    }
  }
}
