{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nethernet:control-v1:diagnostic-completion-receipt",
  "$comment": "Structural syntax only. Normative codecs reject duplicate fields and lossy/alternate original integer tokens, noncanonical base64url/origin, >2048 UTF8 bytes/receipt and >8704 bytes/batch, duplicate original owner+attempt identities. Disposition is authenticated upload settlement only; no expiry, durability or transport claim follows without original report validation and signed committed lifecycle result. Optional diagnosticCompletions root slice uses full65536byte original heartbeat duplicate validation, preserving ordinary telemetry decimals.",
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/batch"
    }
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation",
        "attemptIdHex",
        "completionDigest",
        "receivedAt",
        "disposition"
      ],
      "properties": {
        "installation": {
          "$ref": "urn:nethernet:control-v1:diagnostic-installation#/$defs/binding"
        },
        "attemptIdHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "completionDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "receivedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "disposition": {
          "enum": [
            "recorded",
            "unmatched",
            "expired",
            "conflict"
          ]
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "receipts"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/receipt"
          }
        }
      }
    }
  }
}
