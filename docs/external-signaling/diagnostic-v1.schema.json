{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nxs:diagnostic-v1:draft",
  "title": "NXS diagnostic admission claims",
  "description": "Runtime also verifies canonical bytes, signatures, original authority deadlines and the exact diagnostic offer profile.",
  "$ref": "#/$defs/claims",
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerOrigin",
        "hostId",
        "incarnation",
        "generation"
      ],
      "properties": {
        "providerOrigin": {
          "type": "string",
          "pattern": "^https://[^/?#@]+$",
          "maxLength": 256
        },
        "hostId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "incarnation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expiresAt",
        "clientFingerprintHex",
        "clientIcePwd",
        "attemptIdHex",
        "offerDigestHex",
        "candidateRevision",
        "family",
        "targetAddressHex",
        "targetPort",
        "profile"
      ],
      "properties": {
        "expiresAt": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 4294967295000,
          "multipleOf": 1000
        },
        "clientFingerprintHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clientIcePwd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{22,30}$"
        },
        "attemptIdHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "offerDigestHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidateRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "family": {
          "enum": [
            4,
            6
          ]
        },
        "targetAddressHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "targetPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "profile": {
          "enum": [
            1,
            2
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "targetAddressHex": {
                "type": "string",
                "pattern": "^000000000000000000000000[0-9a-f]{8}$"
              }
            }
          },
          "else": {
            "properties": {
              "targetAddressHex": {
                "not": {
                  "type": "string",
                  "pattern": "^00000000000000000000ffff[0-9a-f]{8}$"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "targetAddressHex": {
                "const": "00000000000000000000000000000000"
              },
              "targetPort": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "targetPort": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "secret",
        "notBefore",
        "retireAt"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "secret": {
          "type": "string",
          "minLength": 1,
          "description": "Valid UTF-8 with32..256 encoded bytes; never log or give to prober."
        },
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retireAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicPointHex",
        "signatureHex"
      ],
      "properties": {
        "publicPointHex": {
          "type": "string",
          "pattern": "^04[0-9a-f]{192}$"
        },
        "signatureHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{192}$"
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localUfrag",
        "icePwd"
      ],
      "properties": {
        "localUfrag": {
          "type": "string",
          "pattern": "^NXD1[A-Z0-9]{4}[A-Za-z0-9+/]+$",
          "minLength": 246,
          "maxLength": 256
        },
        "icePwd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{32}$"
        }
      }
    }
  }
}
