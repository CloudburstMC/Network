{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nethernet.org/external-signaling/control-v1.sessions.schema.json",
  "title": "Draft bootstrap/HTTP envelopes and closed decoded payloads",
  "$comment": "Not activated. In addition to schema: canonical unsigned integer tokens, duplicate-key rejection, strict UTF-8, canonical base64url, original-byte digests/signatures, canonical trusted audience/exact HTTP target, sorted capabilities, transport dependencies, byte ceilings and cross-field deadline/proof/intent/fence association are mandatory. Select the decoded payload definition from authenticated envelope action/kind. A schema-valid proof is not trusted authority or an atomic transition.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/http"
    },
    {
      "$ref": "#/$defs/prepare"
    },
    {
      "$ref": "#/$defs/prepared"
    },
    {
      "$ref": "#/$defs/upgrade"
    },
    {
      "$ref": "#/$defs/challenge"
    },
    {
      "$ref": "#/$defs/activate"
    },
    {
      "$ref": "#/$defs/activated"
    },
    {
      "$ref": "#/$defs/statusRequest"
    },
    {
      "$ref": "#/$defs/currentStatus"
    },
    {
      "$ref": "#/$defs/receiptStatus"
    }
  ],
  "$defs": {
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "opaque": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "addressed",
          "assisted-diagnostic",
          "assisted-gameplay",
          "request-response"
        ]
      },
      "contains": {
        "const": "request-response"
      }
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "keyId",
        "signature"
      ],
      "properties": {
        "scheme": {
          "const": "nxs-control-es384-v1"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{128}$"
        }
      }
    },
    "legacyWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "sessionEpoch",
        "sessionId",
        "connectionId",
        "keyId",
        "machineKeyRevision"
      ],
      "properties": {
        "transport": {
          "const": "legacy-http"
        },
        "sessionEpoch": {
          "const": 0
        },
        "sessionId": {
          "const": ""
        },
        "connectionId": {
          "const": ""
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "machineKeyRevision": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "activeWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "sessionEpoch",
        "sessionId",
        "connectionId",
        "keyId",
        "machineKeyRevision"
      ],
      "properties": {
        "transport": {
          "enum": [
            "websocket",
            "https"
          ]
        },
        "sessionEpoch": {
          "$ref": "#/$defs/positive"
        },
        "sessionId": {
          "$ref": "#/$defs/opaque"
        },
        "connectionId": {
          "$ref": "#/$defs/opaque"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "machineKeyRevision": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "writer": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyWriter"
        },
        {
          "$ref": "#/$defs/activeWriter"
        }
      ]
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "capabilities",
        "clientNonce",
        "expectedWriter",
        "sessionDurationMillis",
        "intentCreatedAt",
        "intentExpiresAt"
      ],
      "properties": {
        "transport": {
          "enum": [
            "websocket",
            "https"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "clientNonce": {
          "$ref": "#/$defs/opaque"
        },
        "expectedWriter": {
          "$ref": "#/$defs/writer"
        },
        "sessionDurationMillis": {
          "$ref": "#/$defs/duration"
        },
        "intentCreatedAt": {
          "$ref": "#/$defs/uint"
        },
        "intentExpiresAt": {
          "$ref": "#/$defs/uint"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "https"
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "const": [
                  "request-response"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "enum": [
                    "assisted-gameplay",
                    "assisted-diagnostic"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "addressed"
                }
              }
            }
          }
        }
      ]
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pendingSessionId",
        "transport",
        "capabilities",
        "clientNonce",
        "connectionId",
        "expectedWriter",
        "intentDigest",
        "preparedAt",
        "expiresAt",
        "sessionDurationMillis"
      ],
      "properties": {
        "pendingSessionId": {
          "$ref": "#/$defs/opaque"
        },
        "transport": {
          "enum": [
            "websocket",
            "https"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "clientNonce": {
          "$ref": "#/$defs/opaque"
        },
        "connectionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedWriter": {
          "$ref": "#/$defs/writer"
        },
        "intentDigest": {
          "$ref": "#/$defs/digest"
        },
        "preparedAt": {
          "$ref": "#/$defs/uint"
        },
        "expiresAt": {
          "$ref": "#/$defs/uint"
        },
        "sessionDurationMillis": {
          "$ref": "#/$defs/duration"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "https"
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "const": [
                  "request-response"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "enum": [
                    "assisted-gameplay",
                    "assisted-diagnostic"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "addressed"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "websocket"
              }
            }
          },
          "then": {
            "properties": {
              "connectionId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "connectionId": {
                "$ref": "#/$defs/opaque"
              }
            }
          }
        }
      ]
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparedProof"
      ],
      "properties": {
        "preparedProof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 21846
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pendingSessionId",
        "transport",
        "capabilities",
        "clientNonce",
        "connectionId",
        "preparedProofSha256",
        "expiresAt",
        "sessionDurationMillis"
      ],
      "properties": {
        "pendingSessionId": {
          "$ref": "#/$defs/opaque"
        },
        "transport": {
          "const": "websocket"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "clientNonce": {
          "$ref": "#/$defs/opaque"
        },
        "connectionId": {
          "$ref": "#/$defs/opaque"
        },
        "preparedProofSha256": {
          "$ref": "#/$defs/digest"
        },
        "expiresAt": {
          "$ref": "#/$defs/uint"
        },
        "sessionDurationMillis": {
          "$ref": "#/$defs/duration"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "https"
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "const": [
                  "request-response"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "enum": [
                    "assisted-gameplay",
                    "assisted-diagnostic"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "addressed"
                }
              }
            }
          }
        }
      ]
    },
    "activate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedWriter",
        "preparedProof",
        "connectionProof"
      ],
      "properties": {
        "expectedWriter": {
          "$ref": "#/$defs/writer"
        },
        "preparedProof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 21846
        },
        "connectionProof": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 21846
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "activated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentDigest",
        "writer",
        "capabilities",
        "activatedAt",
        "sessionExpiresAt",
        "authoritySourceCheckedAt",
        "authorityExpiresAt"
      ],
      "properties": {
        "intentDigest": {
          "$ref": "#/$defs/digest"
        },
        "writer": {
          "$ref": "#/$defs/activeWriter"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "activatedAt": {
          "$ref": "#/$defs/uint"
        },
        "sessionExpiresAt": {
          "$ref": "#/$defs/uint"
        },
        "authoritySourceCheckedAt": {
          "$ref": "#/$defs/uint"
        },
        "authorityExpiresAt": {
          "$ref": "#/$defs/uint"
        }
      }
    },
    "statusRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "const": "current-writer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "intentDigest"
          ],
          "properties": {
            "query": {
              "const": "intent-receipt"
            },
            "intentDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "currentStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "writer",
        "capabilities",
        "activatedAt",
        "sessionExpiresAt",
        "authoritySourceCheckedAt",
        "authorityExpiresAt",
        "writerEnabled"
      ],
      "properties": {
        "query": {
          "const": "current-writer"
        },
        "writer": {
          "$ref": "#/$defs/writer"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "addressed",
              "assisted-diagnostic",
              "assisted-gameplay",
              "request-response"
            ]
          }
        },
        "activatedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionExpiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint"
            },
            {
              "type": "null"
            }
          ]
        },
        "authoritySourceCheckedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorityExpiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint"
            },
            {
              "type": "null"
            }
          ]
        },
        "writerEnabled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "writer": {
                "properties": {
                  "transport": {
                    "const": "legacy-http"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "const": []
              },
              "activatedAt": {
                "type": "null"
              },
              "sessionExpiresAt": {
                "type": "null"
              },
              "authoritySourceCheckedAt": {
                "type": "null"
              },
              "authorityExpiresAt": {
                "type": "null"
              },
              "writerEnabled": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "capabilities": {
                "$ref": "#/$defs/capabilities"
              },
              "activatedAt": {
                "$ref": "#/$defs/uint"
              },
              "sessionExpiresAt": {
                "$ref": "#/$defs/uint"
              },
              "authoritySourceCheckedAt": {
                "$ref": "#/$defs/uint"
              },
              "authorityExpiresAt": {
                "$ref": "#/$defs/uint"
              }
            }
          }
        }
      ]
    },
    "receiptStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "intentDigest",
        "receipt"
      ],
      "properties": {
        "query": {
          "const": "intent-receipt"
        },
        "intentDigest": {
          "$ref": "#/$defs/digest"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "audience",
        "operation",
        "instanceId",
        "generation",
        "sequence",
        "idempotencyKey",
        "payloadSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "audience": {
          "type": "string",
          "maxLength": 2048
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/positive"
        },
        "sequence": {
          "$ref": "#/$defs/positive"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/opaque"
        },
        "payloadSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intentDigest",
        "operation",
        "instanceId",
        "generation",
        "sequence",
        "idempotencyKey",
        "disposition",
        "committedAt",
        "commitRevision",
        "code"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "intentDigest": {
          "$ref": "#/$defs/digest"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/positive"
        },
        "sequence": {
          "$ref": "#/$defs/positive"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/opaque"
        },
        "disposition": {
          "enum": [
            "committed",
            "rejected",
            "expired",
            "unknown"
          ]
        },
        "committedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint"
            },
            {
              "type": "null"
            }
          ]
        },
        "commitRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "disposition": {
            "const": "committed"
          }
        }
      },
      "then": {
        "properties": {
          "committedAt": {
            "$ref": "#/$defs/uint"
          },
          "commitRevision": {
            "$ref": "#/$defs/uint"
          },
          "code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "committedAt": {
            "type": "null"
          },
          "commitRevision": {
            "type": "null"
          }
        }
      }
    },
    "operation": {
      "enum": [
        "heartbeat",
        "outcomes",
        "rotate",
        "retire",
        "deregister"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "audience",
        "instanceId",
        "generation",
        "sentAt",
        "expiresAt",
        "payload",
        "payloadSha256",
        "authentication",
        "action",
        "requestId",
        "method",
        "encodedPathAndQuery"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "audience": {
          "type": "string",
          "maxLength": 2048
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/positive"
        },
        "sentAt": {
          "$ref": "#/$defs/uint"
        },
        "expiresAt": {
          "$ref": "#/$defs/uint"
        },
        "payload": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 10923
        },
        "payloadSha256": {
          "$ref": "#/$defs/digest"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "action": {
          "enum": [
            "prepare",
            "upgrade",
            "activate",
            "status"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/opaque"
        },
        "method": {
          "enum": [
            "POST",
            "GET"
          ]
        },
        "encodedPathAndQuery": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "upgrade"
              }
            }
          },
          "then": {
            "properties": {
              "method": {
                "const": "GET"
              }
            }
          },
          "else": {
            "properties": {
              "method": {
                "const": "POST"
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "audience",
        "instanceId",
        "generation",
        "sentAt",
        "expiresAt",
        "payload",
        "payloadSha256",
        "authentication",
        "kind",
        "requestId",
        "requestIntentDigest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "audience": {
          "type": "string",
          "maxLength": 2048
        },
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "generation": {
          "$ref": "#/$defs/positive"
        },
        "sentAt": {
          "$ref": "#/$defs/uint"
        },
        "expiresAt": {
          "$ref": "#/$defs/uint"
        },
        "payload": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 10923
        },
        "payloadSha256": {
          "$ref": "#/$defs/digest"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "kind": {
          "enum": [
            "prepared",
            "connection-challenge",
            "activated",
            "status"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/opaque"
        },
        "requestIntentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "audience",
        "method",
        "encodedPathAndQuery",
        "sentAt",
        "expiresAt",
        "intent",
        "sessionId",
        "sessionEpoch",
        "connectionId",
        "writerTransport",
        "capabilities",
        "authentication"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "audience": {
          "type": "string",
          "maxLength": 2048
        },
        "method": {
          "const": "POST"
        },
        "encodedPathAndQuery": {
          "type": "string",
          "maxLength": 2048
        },
        "sentAt": {
          "$ref": "#/$defs/uint"
        },
        "expiresAt": {
          "$ref": "#/$defs/uint"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "sessionId": {
          "$ref": "#/$defs/opaque"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/positive"
        },
        "connectionId": {
          "$ref": "#/$defs/opaque"
        },
        "writerTransport": {
          "enum": [
            "websocket",
            "https"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "writerTransport": {
                "const": "https"
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "const": [
                  "request-response"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "enum": [
                    "assisted-gameplay",
                    "assisted-diagnostic"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "addressed"
                }
              }
            }
          }
        }
      ]
    }
  }
}
