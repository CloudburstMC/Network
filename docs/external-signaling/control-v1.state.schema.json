{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nethernet:control-v1:state",
  "oneOf": [
    {
      "$ref": "#/$defs/ticketPolicy"
    },
    {
      "$ref": "#/$defs/appliedBasis"
    },
    {
      "$ref": "#/$defs/stateSummary"
    },
    {
      "$ref": "#/$defs/acknowledgement"
    }
  ],
  "$defs": {
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "notBefore",
        "acceptUntil"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptUntil": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ticketPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "activeKeyId",
        "epochs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "activeKeyId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "epochs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/epoch"
          }
        }
      }
    },
    "appliedBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "generation",
        "desiredRevision",
        "state",
        "admission",
        "hostProfileRevision",
        "ticketPolicySha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "desiredRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "serving",
            "draining",
            "closed"
          ]
        },
        "admission": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "hostProfileRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ticketPolicySha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "serving"
              }
            }
          },
          "then": {
            "properties": {
              "admission": {
                "const": "enabled"
              },
              "hostProfileRevision": {
                "type": "string"
              },
              "ticketPolicySha256": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "admission": {
                "const": "disabled"
              },
              "hostProfileRevision": {
                "type": "null"
              },
              "ticketPolicySha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "stateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desiredRevision",
        "desiredState",
        "appliedBasisSha256"
      ],
      "properties": {
        "desiredRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "desiredState": {
          "enum": [
            "serving",
            "draining",
            "closed"
          ]
        },
        "appliedBasisSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "syncId",
        "desiredRevision",
        "desiredState",
        "appliedBasisSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "syncId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "desiredRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "desiredState": {
          "enum": [
            "serving",
            "draining",
            "closed"
          ]
        },
        "appliedBasisSha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        }
      }
    }
  }
}
